{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true, "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "isolatedModules": true, "noFallthroughCasesInSwitch": true, "types": ["vite/client"]
  },
  "include": ["src", "shared"]
}
